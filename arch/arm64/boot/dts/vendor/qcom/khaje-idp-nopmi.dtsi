#include <dt-bindings/clock/qcom,gcc-khaje.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/input/qcom,qpnp-power-on.h>
#define TB128FU_BOARD
#include "khaje-idp.dtsi"

&reserved_memory {
	pstore_mem: pstore_region@64000000 {
		compatible = "removed-dma-pool";
		no-map;
		reg = <0x0 0x64000000 0x0 0x100000>;
	};
};

&dsi_td4330_truly_v2_video {
	/delete-property/ qcom,esd-check-enabled;
};

&dsi_td4330_truly_v2_cmd {
	/delete-property/ qcom,esd-check-enabled;
};

&dsi_nt36672e_fhd_plus_90hz_video {
	/delete-property/ qcom,esd-check-enabled;
};



&usb0 {
	extcon = <&rpm>;
	dwc3@4e00000 {
		dr_mode = "otg";
		maximum-speed = "high-speed";
		usb-phy = <&usb2_phy0>, <&usb_nop_phy>;
	};
};
&tlmm {
	qupv3_se0_spi_pins: qupv3_se0_spi_pins {
		qupv3_se0_spi_active: qupv3_se0_spi_active {

			mux {
				pins = "gpio0", "gpio1", "gpio2";
				function = "qup0";
			};

			config {
				pins = "gpio0", "gpio1", "gpio2";
				drive-strength = <0x06>;
				bias-disable;
			};
		};

		qupv3_se0_spi_sleep: qupv3_se0_spi_sleep {

			mux {
				pins = "gpio0", "gpio1", "gpio2";
				function = "qup0";
			};

			config {
				pins = "gpio0", "gpio1", "gpio2";
				drive-strength = <0x06>;
				bias-disable;
			};
		};

		qupv3_se0_spi_cs_active: qupv3_se0_spi_cs_active {

			mux {
				pins = "gpio3";
				function = "qup0";
			};

			config {
				pins = "gpio3";
				drive-strength = <0x06>;
				output-high;
				bias-disable;
			};
		};

		qupv3_se0_spi_cs_sleep: qupv3_se0_spi_cs_sleep {

			mux {
				pins = "gpio3";
				function = "qup0";
			};

			config {
				pins = "gpio3";
				drive-strength = <0x06>;
				output-high;
				bias-disable;
			};
		};
	};

	bq25890_int_default: bq25890_int_default {

		mux {
			pins = "gpio65";
			function = "gpio";
		};

		config {
			pins = "gpio65";
			drive-strength = <0x02>;
			bias-pull-up;
			input-enable;
		};
	};

	usb_switch_default: usb_switch_default {

		mux {
			pins = "gpio112";
			function = "gpio";
		};

		config {
			pins = "gpio112";
			bias-disable = <0x00>;
			drive-strength = <0x02>;
			output-low;
		};
	};

	slave_chg_en_default: slave_chg_en_default {

		mux {
			pins = "gpio16";
			function = "gpio";
		};

		config {
			pins = "gpio16";
			bias-disable = <0x00>;
			drive-strength = <0x02>;
			output-high;
		};
	};

	slave_chg_int_default: slave_chg_int_default {

		mux {
			pins = "gpio66";
			function = "gpio";
		};

		config {
			pins = "gpio66";
			drive-strength = <0x02>;
			bias-pull-up;
			input-enable;
		};
	};

	sgm_bl_active: sgm_bl_active {

		mux {
			pins = "gpio103";
			function = "gpio";
		};

		config {
			pins = "gpio103";
			drive-strength = <0x08>;
			bias-disable = <0x00>;
			output-high;
		};
	};

	sgm_bl_suspend: sgm_bl_suspend {

		mux {
			pins = "gpio103";
			function = "gpio";
		};

		config {
			pins = "gpio103";
			drive-strength = <0x02>;
			bias-pull-down;
			input-enable;
		};
	};
};

&qupv3_se0_spi {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&qupv3_se0_spi_active &qupv3_se0_spi_cs_active>;
	pinctrl-1 = <&qupv3_se0_spi_sleep &qupv3_se0_spi_cs_sleep>;

	himax_ts@0 {
		compatible = "himax,hxcommon";
		reg = <0x00>;
		spi-max-frequency = <0x989680>;
		spi-cpha;
		interrupt-parent = <&tlmm>;
		interrupts = <80 0x2008>;
		himax,panel-coords = <0x00 0x4b0 0x00 0x7d0>;
		himax,display-coords = <0x00 0x4b0 0x00 0x7d0>;
		himax,irq-gpio = <&tlmm 80 0x2008>;
		himax,rst-gpio = <&tlmm 86 0x00>;
		report_type = <0x01>;
		panel = <&dsi_hx83102p_boe_2k_video>;
	};

	novatek@1 {
		compatible = "novatek,NVT-ts-spi";
		reg = <0x01>;
		spi-max-frequency = <0x927c00>;
		interrupt-parent = <&tlmm>;
		interrupts = <80 0x2008>;
		novatek,reset-gpio = <&tlmm 86 0x00>;
		novatek,irq-gpio = <&tlmm 80 0x2008>;
		panel = <&dsi_nt36523w_tm_2k_video &dsi_nt36523w_tm_2k_apcf_video>;
		novatek,pen-support;
		novatek,stylus-resol-double;
		novatek,swrst-n8-addr = <0x3f0fe>;
		novatek,spi-rd-fast-addr = <0x3f310>;
		status = "okay";

		novatek-mp-criteria-6048@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "novatek-mp-criteria-6048";
			IC_X_CFG_SIZE = <0x12>;
			IC_Y_CFG_SIZE = <0x24>;
			IC_KEY_CFG_SIZE = <0x04>;
			X_Channel = <0x12>;
			Y_Channel = <0x24>;
			AIN_X = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11>;
			AIN_Y = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23>;
			AIN_KEY = <0x00 0x01 0x02 0xff>;
			PS_Config_Lmt_Short_Rawdata_P = <0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36b8 0x36